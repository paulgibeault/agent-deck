{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent-deck-main",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.mjs",
        "--open"
      ],
      "port": 7777,
      "url": "http://127.0.0.1:7777"
    },
    {
      "name": "agent-deck",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.mjs",
        "--port",
        "7778",
        "--token",
        "devtoken"
      ],
      "port": 7778,
      "url": "http://127.0.0.1:7778"
    },
    {
      "name": "agent-deck-fake-model",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.mjs",
        "--port",
        "7779",
        "--token",
        "devtoken"
      ],
      "env": {
        "DECK_CLAUDE_BIN": "test/fixtures/fake-claude.mjs"
      },
      "port": 7779,
      "url": "http://127.0.0.1:7779"
    },
    {
      "name": "agent-deck-fake-agent",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.mjs",
        "--port",
        "7780",
        "--token",
        "devtoken"
      ],
      "env": {
        "DECK_AGENT_BIN": "test/fixtures/fake-agent.mjs",
        "DECK_CLAUDE_BIN": "test/fixtures/fake-claude.mjs",
        "CLAUDE_CONFIG_DIR": "/tmp/agent-deck-fake/claude",
        "DECK_STATE_DIR": "/tmp/agent-deck-fake/state"
      },
      "port": 7780,
      "url": "http://127.0.0.1:7780"
    }
  ]
}
